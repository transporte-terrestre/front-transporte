{
  "navigationFallback": {
    "rewrite": "/index.csr.html",
    "exclude": ["/images/*.{png,jpg,gif}", "/css/*"]
  },
  "routes": [
    {
      "route": "/",
      "rewrite": "/index.csr.html"
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/index.csr.html"
    }
  },
  "mimeTypes": {
    ".html": "text/html"
  }
}